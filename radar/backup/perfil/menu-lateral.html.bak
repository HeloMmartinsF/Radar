                               placeholder="UF">
                        <div id="uf-suggestions" class="hidden absolute left-0 top-[calc(100%+6px)] z-[70] w-full max-w-[120px] max-h-52 overflow-y-auto rounded-xl border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30"></div>
                    </div>
                    <select id="filtro-aceita-cpf" onchange="filtrar()"
