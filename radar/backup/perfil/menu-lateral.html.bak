                           placeholder="Todas Cidades">
                    <div id="cidade-suggestions" class="hidden absolute left-0 top-[calc(100%+6px)] z-[70] w-full max-w-[260px] max-h-52 overflow-y-auto rounded-xl border border-slate-700 bg-slate-900 shadow-2xl shadow-black/30"></div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div class="relative">
                        <input type="text" id="filtro-uf" autocomplete="off"
